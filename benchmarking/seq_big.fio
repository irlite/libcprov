[global]
ioengine=psync
bs=1M
direct=1
runtime=30
time_based=1
filename=fio_testfile
size=4G

[seq-read]
rw=read
stonewall

[seq-write]
rw=write
stonewall


[global]
ioengine=psync
direct=1
bs=1M
size=4g
runtime=30
time_based=1
group_reporting

[read-test]
rw=read
filename=/tmp/testfile

[write-test]
rw=write
filename=/tmp/testfile
